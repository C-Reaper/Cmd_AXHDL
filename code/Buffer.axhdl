from unsigned import *
from std import *
from seg7 import *

arch MAIN
    unsigned<1> in x
    unsigned<1> in y
    unsigned<1> out e
    unsigned<1> out ne
    unsigned<1> out g
    unsigned<1> out l
    unsigned<1> out ge
    unsigned<1> out le
    
    e = x == y
    ne = x != y
    g = x > y
    l = x < y
    ge = x >= y
    le = x <= y

    chip SEG7 s0
        s0.a = x == y
    end
    chip SEG7 s1
        s1.a = x != y
    end
    chip SEG7 s2
        s2.a = x > y
    end
    chip SEG7 s3
        s3.a = x < y
    end
    chip SEG7 s4
        s4.a = x >= y
    end
    chip SEG7 s5
        s5.a = x <= y
    end
end

arch MAIN
    unsigned<1> in a
    unsigned<1> in b
    unsigned<1> out c
    
    chip MUX m0
        m0.a = a
        m0.b = b
        m0.c = a > b
    end
    chip MUX m1
        m1.a = m0.d
        m1.b = a + a
        m1.c = m0.d > b
        c = m1.d
    end

    chip SEG7 s0
        s0.a = a
    end
    chip SEG7 s1
        s1.a = b
    end
    chip SEG7 s2
        s2.a = m1.d
    end
end

